# Copy to .env and fill in. Never commit .env.

# --- Which LLM to use ---
# azure = cloud model in Azure AI Foundry (needs internet, billed per token)
# local = model running on your own machine (works offline, no token bill)
LLM_PROVIDER=azure

# Used when LLM_PROVIDER=azure
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=<your-api-key>
AZURE_AI_MODEL=<your-model-deployment-name>

# Used when LLM_PROVIDER=local. Any OpenAI-compatible local runtime works:
#   Ollama     http://localhost:11434/v1   (model name as in `ollama list`, e.g. qwen2.5:7b)
#   LM Studio  http://localhost:1234/v1
#   vLLM       http://localhost:8000/v1    (move this app to another port, e.g. 8001)
# Pick a model that supports tool calling (e.g. qwen2.5, qwen3, llama3.1, mistral-nemo).
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
# Only if your local runtime requires a key (Ollama and LM Studio do not).
LOCAL_LLM_API_KEY=

# --- Security settings (safe defaults) ---
# Require this key in the X-API-Key header. Leave empty only for local dev.
APP_API_KEY=
# Browser origin allowed to call the API (CORS). If the page is hosted on Vercel: https://nsip-ai.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# false = the agent may only probe public internet hosts (blocks SSRF into your LAN / cloud metadata).
# true  = also allow RFC1918 private ranges (for troubleshooting inside a trusted network).
ALLOW_PRIVATE_TARGETS=false
